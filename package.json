{
  "name": "mini-diary",
  "productName": "Mini Diary",
  "version": "1.0.0",
  "description": "本地优先、默认加密、离线可用的桌面日记",
  "main": "./out/main/index.js",
  "author": {
    "name": "Mini Diary",
    "email": "hello@minidiary.app"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:stylelint": "stylelint \"src/renderer/src/**/*.scss\" --max-warnings 0",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,scss,json,md}\"",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:component && pnpm build",
    "package:dir": "pnpm build && node scripts/package-dir.mjs",
    "package:mac": "pnpm build && node scripts/package-dir.mjs --mac",
    "package:win": "pnpm build && node scripts/package-dir.mjs --win",
    "package:linux": "pnpm build && node scripts/package-dir.mjs --linux"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "electron-log": "^5.4.4",
    "sanitize-html": "^2.18.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns": "^4.4.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.69.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sass-embedded": "^1.108.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
